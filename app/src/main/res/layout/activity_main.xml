<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/padding_medium"
    android:background="@drawable/bg_gradient">

    <!-- Encabezado con título y subtítulo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_menu"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona una opción para comenzar"
            android:textSize="14sp"
            android:textColor="#E2E8F0"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Botón 1: Promedio -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_ejercicio1"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textColor="#1E3A8A"
        app:backgroundTint="#FFFFFF"
        app:iconTint="#1E3A8A"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Botón 2: Salario -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_ejercicio2"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textColor="#1E3A8A"
        app:backgroundTint="#FFFFFF"
        app:iconTint="#1E3A8A"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_agenda"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Botón 3: Calculadora -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEjercicio3"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_ejercicio3"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textColor="#1E3A8A"
        app:backgroundTint="#FFFFFF"
        app:iconTint="#1E3A8A"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_sort_by_size"
        app:iconGravity="textStart"
        app:iconPadding="12dp" />

</LinearLayout>